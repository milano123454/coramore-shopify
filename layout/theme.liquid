<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=5.0">

    <title>
      {%- if page_title == blank -%}{{ shop.name }}
      {%- else -%}{{ page_title }}{% if current_page != 1 %} &ndash; Pagina {{ current_page }}{% endif %}
      {%- endif -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- unless settings.heading_font.system? -%}
      <link rel="preload" href="{{ settings.heading_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- unless settings.body_font.system? -%}
      <link rel="preload" href="{{ settings.body_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {{ settings.heading_font | font_face: font_display: 'swap' }}
    {{ settings.body_font | font_face: font_display: 'swap' }}

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --font-heading: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
        --font-heading-weight: {{ settings.heading_font.weight }};
        --font-heading-style: {{ settings.heading_font.style }};
        --font-body: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
        --font-body-weight: {{ settings.body_font.weight }};
        --font-body-style: {{ settings.body_font.style }};
        --font-body-size: {{ settings.body_font_size }}px;

        --color-bg: {{ settings.color_background }};
        --color-text: {{ settings.color_text }};
        --color-heading: {{ settings.color_heading }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-text: {{ settings.color_accent_text }};
        --color-secondary-bg: {{ settings.color_secondary_bg }};
        --color-border: {{ settings.color_border }};
        --color-sale: {{ settings.color_sale }};

        --announcement-bg: {{ settings.announcement_bg }};
        --announcement-text: {{ settings.announcement_text_color }};
      }
    </style>

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a href="#main-content" class="skip-to-content">Vai al contenuto</a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="main-content" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
