<div class="countdown" data-countdown data-end="{{ settings.countdown_end }}">
  <div class="countdown__label">⏰ Offerta termina tra:</div>
  <div class="countdown__timer">
    <div class="countdown__block">
      <span class="countdown__number" data-countdown-days>00</span>
      <span class="countdown__unit">Giorni</span>
    </div>
    <span class="countdown__separator">:</span>
    <div class="countdown__block">
      <span class="countdown__number" data-countdown-hours>00</span>
      <span class="countdown__unit">Ore</span>
    </div>
    <span class="countdown__separator">:</span>
    <div class="countdown__block">
      <span class="countdown__number" data-countdown-minutes>00</span>
      <span class="countdown__unit">Min</span>
    </div>
    <span class="countdown__separator">:</span>
    <div class="countdown__block">
      <span class="countdown__number" data-countdown-seconds>00</span>
      <span class="countdown__unit">Sec</span>
    </div>
  </div>
</div>
