{%- assign product = product -%}
<section class="product-section section" data-section-id="{{ section.id }}" data-testid="product-main">
  <div class="page-width">
    <!-- Trustpilot Banner -->
    {%- if section.settings.show_banner -%}
    <div class="product__tp-banner reveal-on-scroll">
      {%- render 'review-stars', rating: 4.9, color: '#00B67A' -%}
      <span>{{ section.settings.banner_text }}</span>
    </div>
    {%- endif -%}

    <div class="product__grid">
      <!-- Gallery -->
      <div class="product__gallery reveal-on-scroll">
        <div class="product__gallery-main">
          {%- if product.featured_image -%}
            <img id="product-main-image" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | escape }}" width="800" height="800" loading="eager" class="product__main-image" data-zoom>
          {%- else -%}
            <div class="product__placeholder">{{ 'product-1' | placeholder_svg_tag: 'product__placeholder-svg' }}</div>
          {%- endif -%}
        </div>
        <div class="product__thumbnails">
          {%- for image in product.images -%}
            <button class="product__thumbnail{% if forloop.first %} product__thumbnail--active{% endif %}" data-thumbnail data-image-url="{{ image | image_url: width: 800 }}" data-image-alt="{{ image.alt | escape }}" aria-label="Immagine {{ forloop.index }}">
              <img src="{{ image | image_url: width: 120 }}" alt="{{ image.alt | escape }}" width="120" height="120" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      </div>

      <!-- Product Info -->
      <div class="product__info">
        {%- if section.settings.show_urgency -%}
          <div class="product__urgency reveal-on-scroll">{{ section.settings.urgency_text }}</div>
        {%- endif -%}

        <h1 class="product__title reveal-on-scroll">{{ product.title }}</h1>

        <a href="#recensioni" class="product__rating reveal-on-scroll">
          {%- render 'review-stars', rating: 4.9, color: '#00B67A' -%}
          <span>{{ section.settings.rating_text | default: '2.437 recensioni' }}</span>
        </a>

        <div class="product__price reveal-on-scroll">
          {%- if product.compare_at_price > product.price -%}
            <span class="product__price-sale">{{ product.price | money }}</span>
            <span class="product__price-was">{{ product.compare_at_price | money }}</span>
            {%- assign disc = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
            <span class="product__price-badge">-{{ disc }}%</span>
          {%- else -%}
            <span class="product__price-regular">{{ product.price | money }}</span>
          {%- endif -%}
        </div>

        {%- if section.settings.show_discount_code -%}
          <div class="product__discount reveal-on-scroll">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/></svg>
            <span>{{ section.settings.discount_before }} <strong class="product__discount-code">{{ section.settings.discount_code }}</strong> {{ section.settings.discount_after }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.show_countdown -%}
          <div class="product__countdown reveal-on-scroll" data-countdown data-testid="countdown-timer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{{ section.settings.countdown_label }}</span>
            <span class="countdown__timer" data-countdown-display>00:00:00</span>
          </div>
        {%- endif -%}

        {%- unless product.has_only_default_variant -%}
          <div class="product__variants reveal-on-scroll">
            {%- for option in product.options_with_values -%}
              <div class="product__option">
                <label class="product__option-label">{{ option.name }}</label>
                <div class="product__option-values">
                  {%- for value in option.values -%}
                    <button class="product__swatch{% if option.selected_value == value %} product__swatch--active{% endif %}" data-option-index="{{ forloop.parentloop.index0 }}" data-value="{{ value }}">{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <!-- Quantity + Add to Cart INLINE -->
        <form method="post" action="/cart/add" id="product-form" data-testid="product-form">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <div class="product__buy-row reveal-on-scroll">
            <div class="quantity-selector">
              <button type="button" class="quantity-selector__btn" data-qty-minus>-</button>
              <input type="number" class="quantity-selector__input" value="1" min="1" max="99" data-qty-input name="quantity">
              <button type="button" class="quantity-selector__btn" data-qty-plus>+</button>
            </div>
            <button type="submit" class="btn btn--primary btn--large product__atc" style="background:{{ section.settings.cta_bg_color }};color:{{ section.settings.cta_text_color }};" {% unless product.available %}disabled{% endunless %}>
              {%- if product.available -%}{{ section.settings.cta_text | default: 'AGGIUNGI AL CARRELLO' }}{%- else -%}Esaurito{%- endif -%}
            </button>
          </div>
        </form>

        {%- if section.settings.show_buy_now -%}
          <a href="/checkout" class="btn btn--outline product__buy-now reveal-on-scroll" data-testid="buy-now-btn">{{ section.settings.buy_now_text | default: 'ACQUISTA SUBITO' }}</a>
        {%- endif -%}

        <div class="product__trust reveal-on-scroll">
          {%- render 'trust-bar' -%}
        </div>

        <!-- Accordion Details -->
        <div class="product__details reveal-on-scroll">
          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' -%}
              <div class="product__acc" {{ block.shopify_attributes }}>
                <button class="product__acc-btn" data-faq-toggle aria-expanded="false">
                  <span>{{ block.settings.title }}</span>
                  <svg class="faq-item__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
                <div class="faq-item__answer" data-faq-answer><div class="faq-item__answer-inner">{{ block.settings.content }}</div></div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Prodotto principale",
  "settings": [
    { "type": "checkbox", "id": "show_banner", "label": "Mostra banner Trustpilot", "default": true },
    { "type": "text", "id": "banner_text", "label": "Testo banner", "default": "2.400+ clienti soddisfatte — 4.9/5" },
    { "type": "checkbox", "id": "show_urgency", "label": "Mostra badge urgenza", "default": true },
    { "type": "text", "id": "urgency_text", "label": "Testo urgenza", "default": "Ultimi 7 disponibili" },
    { "type": "text", "id": "rating_text", "label": "Testo rating", "default": "2.437 recensioni" },
    { "type": "checkbox", "id": "show_discount_code", "label": "Mostra codice sconto", "default": true },
    { "type": "text", "id": "discount_before", "label": "Testo prima del codice", "default": "Usa il codice" },
    { "type": "text", "id": "discount_code", "label": "Codice sconto", "default": "REGALO" },
    { "type": "text", "id": "discount_after", "label": "Testo dopo il codice", "default": "— Sconto 20%" },
    { "type": "checkbox", "id": "show_countdown", "label": "Mostra countdown", "default": true },
    { "type": "text", "id": "countdown_label", "label": "Testo countdown", "default": "Offerta scade tra:" },
    { "type": "text", "id": "cta_text", "label": "Testo bottone CTA", "default": "AGGIUNGI AL CARRELLO" },
    { "type": "color", "id": "cta_bg_color", "label": "Colore sfondo CTA", "default": "#111111" },
    { "type": "color", "id": "cta_text_color", "label": "Colore testo CTA", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "show_buy_now", "label": "Mostra Acquista subito", "default": true },
    { "type": "text", "id": "buy_now_text", "label": "Testo Acquista subito", "default": "ACQUISTA SUBITO" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Dettaglio",
      "settings": [
        { "type": "text", "id": "title", "label": "Titolo", "default": "Materiali" },
        { "type": "richtext", "id": "content", "label": "Contenuto", "default": "<p>Pelle vegana premium, fodera interna in poliestere.</p>" }
      ]
    }
  ]
}
{% endschema %}
