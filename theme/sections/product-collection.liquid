{%- liquid
  assign collection_obj = collections[section.settings.collection]
-%}
<section class="section section--alt">
  <div class="container">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}
        <div class="section-head__eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      <h2 class="section-head__title">{{ section.settings.title }}</h2>
      {%- if section.settings.lede != blank -%}
        <p class="section-head__lede">{{ section.settings.lede }}</p>
      {%- endif -%}
    </div>

    <div class="showcase-grid">
      {%- if collection_obj and collection_obj.products.size > 0 -%}
        {%- for product in collection_obj.products limit: 4 -%}
          {%- assign badge = '' -%}
          {%- if forloop.first and section.settings.show_bestseller -%}{%- assign badge = 'Bestseller' -%}{%- endif -%}
          {% render 'product-card', product: product, badge: badge %}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- assign p = block.settings -%}
          <a class="product-card" href="{{ p.link | default: '#' }}" {{ block.shopify_attributes }}>
            <div class="product-card__media">
              {%- if p.image != blank -%}
                <img src="{{ p.image | image_url: width: 800 }}" alt="{{ p.color | escape }} {{ p.title | escape }}" loading="lazy">
              {%- else -%}
                <img src="{{ p.image_fallback | default: 'product-nero.png' | asset_url }}" alt="{{ p.title | escape }}" loading="lazy">
              {%- endif -%}
              {%- if p.badge != blank -%}<span class="product-card__badge">{{ p.badge }}</span>{%- endif -%}
              {%- if p.discount != blank -%}<span class="product-card__discount">{{ p.discount }}</span>{%- endif -%}
            </div>
            <div class="product-card__body">
              <div class="product-card__color">{{ p.color }}</div>
              <h3 class="product-card__title">{{ p.title }}</h3>
              {%- if p.subtitle != blank -%}
                <div class="product-card__subtitle">{{ p.subtitle }}</div>
              {%- endif -%}
              <div class="product-card__price">
                <span class="now">{{ p.price_now }}</span>
                {%- if p.price_was != blank -%}<span class="was">{{ p.price_was }}</span>{%- endif -%}
                {%- if p.discount != blank -%}<span class="off">{{ p.discount }}</span>{%- endif -%}
              </div>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Showcase prodotti",
  "tag": "section",
  "class": "shopify-section-showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "La Collezione" },
    { "type": "text", "id": "title", "label": "Titolo", "default": "Diamond Tote · 4 Colori" },
    { "type": "text", "id": "lede",  "label": "Sottotitolo", "default": "Ogni colore con portafoglio abbinato incluso. Scegli il tuo." },
    { "type": "collection", "id": "collection", "label": "Collezione (opzionale)", "info": "Se selezionata, sostituisce i blocchi qui sotto." },
    { "type": "checkbox", "id": "show_bestseller", "label": "Badge Bestseller sul primo", "default": true }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card prodotto",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Immagine" },
        { "type": "text", "id": "image_fallback", "label": "Asset fallback (filename)", "default": "product-nero.png" },
        { "type": "text", "id": "color",    "label": "Colore (eyebrow)", "default": "Nero Classico" },
        { "type": "text", "id": "title",    "label": "Titolo", "default": "Diamond Tote Bag" },
        { "type": "text", "id": "subtitle", "label": "Sottotitolo", "default": "+ Portafoglio Incluso Gratis" },
        { "type": "text", "id": "price_now","label": "Prezzo attuale", "default": "€49" },
        { "type": "text", "id": "price_was","label": "Prezzo precedente", "default": "€89" },
        { "type": "text", "id": "discount", "label": "Sconto", "default": "-45%" },
        { "type": "text", "id": "badge",    "label": "Badge (es. BESTSELLER)" },
        { "type": "url",  "id": "link",     "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "card", "settings": { "color": "Nero Classico",   "image_fallback": "product-nero.png",    "badge": "BESTSELLER" } },
      { "type": "card", "settings": { "color": "Marrone Cognac",  "image_fallback": "product-marrone.png" } },
      { "type": "card", "settings": { "color": "Viola Prugna",    "image_fallback": "product-viola.png" } },
      { "type": "card", "settings": { "color": "Verde Hunter",    "image_fallback": "product-verde.png" } }
    ]
  },
  "presets": [{ "name": "Showcase prodotti" }]
}
{% endschema %}
