<header class="site-header">
  <div class="container">
    <div class="site-header__inner">
      <a href="{{ routes.root_url }}" class="site-header__brand" aria-label="{{ shop.name }}">
        <span class="site-header__brand-name">{{ section.settings.brand_name | default: shop.name | upcase }}</span>
        {%- if section.settings.brand_tagline != blank -%}
          <span class="site-header__brand-tagline">{{ section.settings.brand_tagline }}</span>
        {%- endif -%}
      </a>

      <nav class="site-nav" aria-label="Principale">
        {%- for block in section.blocks -%}
          {%- if block.type == 'link' -%}
            <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>

      <div class="site-header__actions">
        <button type="button" class="icon-button" data-cart-toggle aria-label="Apri carrello">
          {% render 'icon-cart' %}
          <span class="cart-badge" data-cart-count{% if cart.item_count == 0 %} style="display:none;"{% endif %}>{{ cart.item_count }}</span>
        </button>
        <button type="button" class="icon-button menu-toggle" data-menu-toggle aria-label="Menu">
          {% render 'icon-menu' %}
        </button>
      </div>
    </div>
  </div>

  <div class="mobile-nav" data-mobile-nav>
    {%- for block in section.blocks -%}
      {%- if block.type == 'link' -%}
        <a href="{{ block.settings.link }}">{{ block.settings.label }}</a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "class": "shopify-section-header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Nome del brand",
      "default": "LUMINA MILANO"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Tagline (sotto al nome)",
      "default": "Milano · Paris · London"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link menu",
      "settings": [
        { "type": "text", "id": "label", "label": "Etichetta", "default": "Home" },
        { "type": "url",  "id": "link",  "label": "URL" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link", "settings": { "label": "Home" } },
      { "type": "link", "settings": { "label": "Collezione" } },
      { "type": "link", "settings": { "label": "Recensioni" } },
      { "type": "link", "settings": { "label": "FAQ" } }
    ]
  }
}
{% endschema %}
