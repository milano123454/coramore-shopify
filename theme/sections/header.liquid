<header class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}" data-section-id="{{ section.id }}" data-testid="site-header">
  <div class="page-width">
    <div class="header__inner">
      <!-- Mobile menu toggle -->
      <button class="header__menu-toggle" data-menu-toggle aria-label="{{ 'general.menu' | t }}" data-testid="mobile-menu-toggle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>

      <!-- Logo -->
      <div class="header__logo">
        {%- if section.settings.logo -%}
          <a href="/">
            <img
              src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo_width }}"
              height="{{ section.settings.logo_width | divided_by: 3 }}"
              loading="eager"
            >
          </a>
        {%- else -%}
          <a href="/" class="header__logo-text">{{ shop.name }}</a>
        {%- endif -%}
      </div>

      <!-- Desktop Navigation -->
      <nav class="header__nav" role="navigation">
        {%- for link in linklists[section.settings.menu].links -%}
          <a href="{{ link.url }}" class="header__nav-link{% if link.active %} header__nav-link--active{% endif %}">
            {{ link.title }}
          </a>
        {%- endfor -%}
        {%- if linklists[section.settings.menu].links.size == 0 -%}
          <a href="/" class="header__nav-link">Home</a>
          <a href="/collections/all" class="header__nav-link">Prodotto</a>
          <a href="/#recensioni" class="header__nav-link">Recensioni</a>
          <a href="/#faq" class="header__nav-link">FAQ</a>
        {%- endif -%}
      </nav>

      <!-- Icons -->
      <div class="header__icons">
        <a href="/search" class="header__icon" aria-label="{{ 'header.search' | t }}">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </a>
        <a href="/cart" class="header__icon header__cart-icon" aria-label="{{ 'header.cart' | t }}" data-testid="cart-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          {%- if cart.item_count > 0 -%}
            <span class="header__cart-count" data-cart-count>{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div class="mobile-menu" data-mobile-menu data-testid="mobile-menu">
    <div class="mobile-menu__overlay" data-menu-close></div>
    <div class="mobile-menu__drawer">
      <button class="mobile-menu__close" data-menu-close aria-label="{{ 'general.close' | t }}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <nav class="mobile-menu__nav">
        {%- for link in linklists[section.settings.menu].links -%}
          <a href="{{ link.url }}" class="mobile-menu__link">{{ link.title }}</a>
        {%- endfor -%}
        {%- if linklists[section.settings.menu].links.size == 0 -%}
          <a href="/" class="mobile-menu__link">Home</a>
          <a href="/collections/all" class="mobile-menu__link">Prodotto</a>
          <a href="/#recensioni" class="mobile-menu__link">Recensioni</a>
          <a href="/#faq" class="mobile-menu__link">FAQ</a>
        {%- endif -%}
      </nav>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150,
      "unit": "px",
      "label": "Larghezza logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu navigazione"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Header fisso su scroll",
      "default": true
    }
  ]
}
{% endschema %}
