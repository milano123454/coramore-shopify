<section class="text-reviews-section section" data-section-id="{{ section.id }}" data-testid="text-reviews" style="background-color:{{ section.settings.bg_color }};">
  <div class="page-width">
    <h2 class="section__title reveal-on-scroll">{{ section.settings.heading }}</h2>

    <!-- Trustpilot-style summary bar -->
    <div class="reviews-summary reveal-on-scroll">
      <div class="reviews-summary__score">
        <span class="reviews-summary__number">{{ section.settings.rating }}</span>
        <span class="reviews-summary__label">su 5</span>
      </div>
      <div class="reviews-summary__stars">
        {%- render 'review-stars', rating: 4.9, color: '#00B67A' -%}
        <span class="reviews-summary__count">Basato su {{ section.settings.review_count }} recensioni</span>
      </div>
      <div class="reviews-summary__bars">
        {%- assign bar_data = '90,6,2,1,1' | split: ',' -%}
        {%- for pct in bar_data -%}
          {%- assign star_num = 5 | minus: forloop.index0 -%}
          <div class="reviews-bar">
            <span class="reviews-bar__label">{{ star_num }} stelle</span>
            <div class="reviews-bar__track">
              <div class="reviews-bar__fill" style="width:{{ pct }}%;"></div>
            </div>
            <span class="reviews-bar__pct">{{ pct }}%</span>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Review Cards — Horizontal Scroll -->
    <div class="reviews-carousel reveal-on-scroll">
      <button class="reviews-carousel__arrow reviews-carousel__arrow--left" data-reviews-scroll-left aria-label="Scorri a sinistra">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="reviews-carousel__track" data-reviews-track>
      {%- for block in section.blocks -%}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="review-card__header">
            <div class="review-card__stars">
              {%- render 'review-stars', rating: block.settings.rating, color: '#00B67A' -%}
            </div>
            <span class="review-card__date">{{ block.settings.date }}</span>
          </div>
          <p class="review-card__title">{{ block.settings.title }}</p>
          <p class="review-card__text">{{ block.settings.text }}</p>
          <span class="review-card__author">{{ block.settings.name }}</span>
          {%- if block.settings.verified -%}
            <span class="review-card__verified">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#00B67A" stroke="white" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              Verificata
            </span>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..6) -%}
          <div class="review-card">
            <div class="review-card__header">
              <div class="review-card__stars">{%- render 'review-stars', rating: 5, color: '#00B67A' -%}</div>
              <span class="review-card__date">{{ 'now' | date: "%d/%m/%Y" }}</span>
            </div>
            <p class="review-card__title">Borsa perfetta!</p>
            <p class="review-card__text">Finalmente una borsa che tiene separato il cibo dal resto. Qualita eccellente e design bellissimo.</p>
            <span class="review-card__author">Cliente verificata</span>
            <span class="review-card__verified">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#00B67A" stroke="white" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              Verificata
            </span>
          </div>
        {%- endfor -%}
      {%- endif -%}
      </div>
      <button class="reviews-carousel__arrow reviews-carousel__arrow--right" data-reviews-scroll-right aria-label="Scorri a destra">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Recensioni Testo",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo sezione",
