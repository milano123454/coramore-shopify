<section class="faq-section section" data-section-id="{{ section.id }}" data-testid="faq-section" id="faq" style="background-color:{{ section.settings.bg_color }};">
  <div class="page-width">
    <h2 class="section__title reveal-on-scroll">{{ section.settings.heading }}</h2>
    <div class="faq-list">
      {%- for block in section.blocks -%}
        <div class="faq-item reveal-on-scroll" {{ block.shopify_attributes }}>
          <button class="faq-item__question" data-faq-toggle aria-expanded="false" data-testid="faq-toggle-{{ forloop.index }}">
            <span>{{ block.settings.question }}</span>
            <svg class="faq-item__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <div class="faq-item__answer" data-faq-answer>
            <div class="faq-item__answer-inner">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- assign default_faqs = "Quanto tempo ci vuole per la consegna?|La consegna standard richiede 3-5 giorni lavorativi in tutta Italia. Spedizione gratuita su tutti gli ordini.,Posso restituire la borsa se non mi soddisfa?|Certo! Hai 30 giorni per restituire il prodotto gratuitamente. Ti rimborsiamo al 100%.,Lo scomparto termico mantiene davvero il freddo?|Si! Lo scomparto inferiore e rivestito con materiale isolante di alta qualita che mantiene le bevande fresche per ore.,Il portafoglio e incluso o va acquistato separatamente?|Il portafoglio abbinato e sempre incluso gratuitamente con ogni borsa Coramore.,Come uso il codice REGALO?|Inserisci il codice REGALO al checkout per ottenere il 20% di sconto immediato sul tuo ordine.,Quali metodi di pagamento accettate?|Accettiamo Visa Mastercard PayPal Apple Pay Google Pay e bonifico bancario. Tutti i pagamenti sono protetti da crittografia SSL." | split: ',' -%}
        {%- for faq_item in default_faqs -%}
          {%- assign parts = faq_item | split: '|' -%}
          <div class="faq-item reveal-on-scroll">
            <button class="faq-item__question" data-faq-toggle aria-expanded="false">
              <span>{{ parts[0] }}</span>
              <svg class="faq-item__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <div class="faq-item__answer" data-faq-answer>
              <div class="faq-item__answer-inner">{{ parts[1] }}</div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo sezione",
      "default": "Domande frequenti"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Colore sfondo",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Domanda",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Domanda",
          "default": "Quanto tempo ci vuole per la consegna?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Risposta",
          "default": "<p>La consegna standard richiede 3-5 giorni lavorativi in tutta Italia. Spedizione gratuita su tutti gli ordini.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Quanto tempo ci vuole per la consegna?",
            "answer": "<p>La consegna standard richiede 3-5 giorni lavorativi in tutta Italia. Spedizione gratuita su tutti gli ordini.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Posso restituire la borsa se non mi soddisfa?",
            "answer": "<p>Certo! Hai 30 giorni per restituire il prodotto gratuitamente. Ti rimborsiamo al 100%.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Lo scomparto termico mantiene davvero il freddo?",
            "answer": "<p>Si! Lo scomparto inferiore e rivestito con materiale isolante di alta qualita che mantiene le bevande fresche per diverse ore.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Il portafoglio e incluso o va acquistato separatamente?",
            "answer": "<p>Il portafoglio abbinato e sempre incluso gratuitamente con ogni borsa Coramore. Non e venduto separatamente.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Come uso il codice REGALO?",
            "answer": "<p>Inserisci il codice REGALO al checkout per ottenere il 20% di sconto immediato sul tuo ordine.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Quali metodi di pagamento accettate?",
            "answer": "<p>Accettiamo Visa, Mastercard, PayPal, Apple Pay, Google Pay e bonifico bancario. Tutti i pagamenti sono protetti da crittografia SSL.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
