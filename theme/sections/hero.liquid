<section class="hero section--hero" data-section-id="{{ section.id }}" data-testid="hero-section">
  <div class="page-width">
    <div class="hero__grid">
      <div class="hero__image-col reveal-on-scroll">
        {%- if section.settings.image -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}" width="800" height="900" loading="eager" class="hero__image">
        {%- else -%}
          <div class="hero__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endif -%}
      </div>
      <div class="hero__text-col">
        {%- if section.settings.badge != blank -%}
          <span class="hero__badge reveal-on-scroll">{{ section.settings.badge }}</span>
        {%- endif -%}
        <h1 class="hero__heading reveal-on-scroll">{{ section.settings.heading }}</h1>
        <p class="hero__subheading reveal-on-scroll">{{ section.settings.subheading }}</p>
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="btn btn--primary btn--large hero__cta reveal-on-scroll" style="background:{{ section.settings.cta_bg }};color:{{ section.settings.cta_color }};">{{ section.settings.cta_text }}</a>
        {%- endif -%}
        {%- if section.settings.show_timer -%}
          <div class="hero__timer reveal-on-scroll" data-countdown data-minutes="{{ section.settings.timer_minutes }}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{{ section.settings.timer_label }}</span>
            <span class="countdown__timer" data-countdown-display>00:00</span>
          </div>
        {%- endif -%}
        <div class="hero__rating-row reveal-on-scroll">
          {%- render 'review-stars', rating: 4.9, color: '#00B67A' -%}
          <span class="hero__rating-text">{{ section.settings.rating_text }}</span>
        </div>
        <div class="hero__trust-badges reveal-on-scroll">
          {%- for block in section.blocks -%}
            <div class="hero__trust-pill" style="background:{{ section.settings.pill_bg }};border-color:{{ section.settings.pill_border }};color:{{ section.settings.pill_color }};" {{ block.shopify_attributes }}>
              {%- if block.settings.icon == 'shipping' -%}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {%- elsif block.settings.icon == 'return' -%}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
              {%- elsif block.settings.icon == 'lock' -%}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              {%- endif -%}
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endfor -%}
          {%- if section.blocks.size == 0 -%}
            <div class="hero__trust-pill" style="background:{{ section.settings.pill_bg }};border-color:{{ section.settings.pill_border }};color:{{ section.settings.pill_color }};"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg><span>Spedizione gratuita</span></div>
            <div class="hero__trust-pill" style="background:{{ section.settings.pill_bg }};border-color:{{ section.settings.pill_border }};color:{{ section.settings.pill_color }};"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg><span>Reso facile 30 giorni</span></div>
            <div class="hero__trust-pill" style="background:{{ section.settings.pill_bg }};border-color:{{ section.settings.pill_border }};color:{{ section.settings.pill_color }};"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span>Pagamento sicuro</span></div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Immagine hero" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Novita 2025" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "La Borsa che Risolve un Problema Reale" },
    { "type": "textarea", "id": "subheading", "label": "Sottotitolo", "default": "Due scomparti separati. Cibo da una parte, tutto il resto dall'altra. Finalmente." },
    { "type": "text", "id": "cta_text", "label": "Testo CTA", "default": "ACQUISTA ORA — Spedizione Gratis" },
    { "type": "url", "id": "cta_url", "label": "Link CTA" },
    { "type": "color", "id": "cta_bg", "label": "Sfondo CTA", "default": "#111111" },
    { "type": "color", "id": "cta_color", "label": "Testo CTA", "default": "#FFFFFF" },
    { "type": "header", "content": "Timer" },
    { "type": "checkbox", "id": "show_timer", "label": "Mostra timer", "default": true },
    { "type": "text", "id": "timer_label", "label": "Testo timer", "default": "Offerta scade tra:" },
    { "type": "range", "id": "timer_minutes", "min": 5, "max": 60, "step": 5, "default": 15, "unit": "min", "label": "Minuti" },
    { "type": "header", "content": "Rating e badge" },
    { "type": "text", "id": "rating_text", "label": "Testo rating", "default": "4.9/5 — Oltre 2.400 recensioni" },
    { "type": "color", "id": "pill_bg", "label": "Sfondo badge", "default": "#F1F8E9" },
    { "type": "color", "id": "pill_border", "label": "Bordo badge", "default": "#C5E1A5" },
    { "type": "color", "id": "pill_color", "label": "Testo badge", "default": "#1A3A2A" }
  ],
  "blocks": [
    {
      "type": "trust_badge", "name": "Badge fiducia",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icona", "options": [{"value":"shipping","label":"Spedizione"},{"value":"return","label":"Reso"},{"value":"lock","label":"Sicurezza"}], "default": "shipping" },
        { "type": "text", "id": "text", "label": "Testo", "default": "Spedizione gratuita" }
      ]
    }
  ],
  "presets": [{
    "name": "Hero",
    "blocks": [
      { "type": "trust_badge", "settings": { "icon": "shipping", "text": "Spedizione gratuita" } },
      { "type": "trust_badge", "settings": { "icon": "return", "text": "Reso facile 30 giorni" } },
      { "type": "trust_badge", "settings": { "icon": "lock", "text": "Pagamento sicuro" } }
    ]
  }]
}
{% endschema %}
