<section class="hero section--hero" data-section-id="{{ section.id }}" data-testid="hero-section">
  <div class="page-width">
    <div class="hero__grid">
      <div class="hero__image-col reveal-on-scroll">
        {%- if section.settings.image -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}" width="800" height="900" loading="eager" class="hero__image">
        {%- else -%}
          <div class="hero__placeholder">{{ 'product-1' | placeholder_svg_tag: 'hero__placeholder-svg' }}</div>
        {%- endif -%}
      </div>
      <div class="hero__text-col">
        {%- if section.settings.badge != blank -%}
          <span class="hero__badge reveal-on-scroll">{{ section.settings.badge }}</span>
        {%- endif -%}
        <h1 class="hero__heading reveal-on-scroll">{{ section.settings.heading }}</h1>
        <p class="hero__subheading reveal-on-scroll">{{ section.settings.subheading }}</p>
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="btn btn--primary btn--large hero__cta reveal-on-scroll" data-testid="hero-cta">{{ section.settings.cta_text }}</a>
        {%- endif -%}
        <!-- Rating row -->
        <div class="hero__rating-row reveal-on-scroll">
          {%- render 'review-stars', rating: 4.9, color: '#00B67A' -%}
          <span class="hero__rating-text">{{ section.settings.rating_text | default: '4.9/5 — Oltre 2.400 recensioni' }}</span>
        </div>
        <!-- Trust Badges - Horizontal -->
        <div class="hero__trust-badges reveal-on-scroll">
          {%- for block in section.blocks -%}
            <div class="hero__trust-pill" {{ block.shopify_attributes }}>
              {%- if block.settings.icon == 'shipping' -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {%- elsif block.settings.icon == 'return' -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
              {%- elsif block.settings.icon == 'lock' -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              {%- endif -%}
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endfor -%}
          {%- if section.blocks.size == 0 -%}
            <div class="hero__trust-pill"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg><span>Spedizione gratuita</span></div>
            <div class="hero__trust-pill"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg><span>Reso facile 30 giorni</span></div>
            <div class="hero__trust-pill"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span>Pagamento sicuro</span></div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Immagine hero" },
    { "type": "text", "id": "badge", "label": "Badge sopra il titolo", "default": "Novita 2025" },
    { "type": "text", "id": "heading", "label": "Titolo H1", "default": "La Borsa che Risolve un Problema Reale" },
    { "type": "textarea", "id": "subheading", "label": "Sottotitolo", "default": "Due scomparti separati. Cibo da una parte, tutto il resto dall'altra. Finalmente." },
    { "type": "text", "id": "cta_text", "label": "Testo CTA", "default": "ACQUISTA ORA — Spedizione Gratis" },
    { "type": "url", "id": "cta_url", "label": "Link CTA" },
    { "type": "text", "id": "rating_text", "label": "Testo rating", "default": "4.9/5 — Oltre 2.400 recensioni" },
    { "type": "color", "id": "cta_bg", "label": "Colore bottone", "default": "#111111" },
    { "type": "color", "id": "cta_color", "label": "Testo bottone", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Badge fiducia",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icona", "options": [{"value":"shipping","label":"Spedizione"},{"value":"return","label":"Reso"},{"value":"lock","label":"Sicurezza"}], "default": "shipping" },
        { "type": "text", "id": "text", "label": "Testo", "default": "Spedizione gratuita" }
      ]
    }
  ],
  "presets": [{
    "name": "Hero",
    "blocks": [
      { "type": "trust_badge", "settings": { "icon": "shipping", "text": "Spedizione gratuita" } },
      { "type": "trust_badge", "settings": { "icon": "return", "text": "Reso facile 30 giorni" } },
      { "type": "trust_badge", "settings": { "icon": "lock", "text": "Pagamento sicuro" } }
    ]
  }]
}
{% endschema %}
