<section class="video-reviews-section section" data-section-id="{{ section.id }}" data-testid="video-reviews" id="recensioni">
  <div class="page-width">
    <h2 class="section__title reveal-on-scroll">{{ section.settings.heading }}</h2>
    <div class="video-reviews__wrapper reveal-on-scroll">
      <button class="video-reviews__arrow video-reviews__arrow--left" data-scroll-left aria-label="Sinistra">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="video-reviews__track" data-video-track>
        {%- for block in section.blocks -%}
          <div class="video-review-card" {{ block.shopify_attributes }}>
            <div class="video-review-card__video" data-video-wrap>
              {%- if block.settings.video_url != blank -%}
                <video src="{{ block.settings.video_url }}" playsinline preload="metadata" loop muted data-video-el></video>
              {%- elsif block.settings.video_file != blank -%}
                {{ block.settings.video_file | video_tag: playsinline: true, loop: true, muted: true, preload: 'metadata', data-video-el: '' }}
              {%- else -%}
                <div class="video-review-card__placeholder">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                </div>
              {%- endif -%}
              <button class="video-play-btn" data-play-btn aria-label="Play">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="#fff"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              </button>
            </div>
            <div class="video-review-card__info">
              <span class="video-review-card__name">{{ block.settings.name }}</span>
              <div class="video-review-card__stars">{%- render 'review-stars', rating: block.settings.rating, color: '#00B67A' -%}</div>
              {%- if block.settings.text != blank -%}
                <p class="video-review-card__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
        {%- if section.blocks.size == 0 -%}
          {%- for i in (1..4) -%}
            <div class="video-review-card">
              <div class="video-review-card__video">
                <div class="video-review-card__placeholder"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.5"><polygon points="5 3 19 12 5 21 5 3"/></svg></div>
                <button class="video-play-btn" data-play-btn><svg width="28" height="28" viewBox="0 0 24 24" fill="#fff"><polygon points="5 3 19 12 5 21 5 3"/></svg></button>
              </div>
              <div class="video-review-card__info">
                <span class="video-review-card__name">Cliente {{ i }}</span>
                <div class="video-review-card__stars">{%- render 'review-stars', rating: 5, color: '#00B67A' -%}</div>
                <p class="video-review-card__text">Borsa fantastica!</p>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <button class="video-reviews__arrow video-reviews__arrow--right" data-scroll-right aria-label="Destra">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Recensioni Video",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Cosa dicono le nostre clienti" }
  ],
  "blocks": [
    {
      "type": "video_review",
      "name": "Recensione video",
      "settings": [
        { "type": "text", "id": "video_url", "label": "URL video (YouTube, Vimeo o diretto)" },
        { "type": "video", "id": "video_file", "label": "Oppure carica video" },
        { "type": "text", "id": "name", "label": "Nome cliente", "default": "Maria R." },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "default": 5, "label": "Stelle" },
        { "type": "text", "id": "text", "label": "Testo recensione breve", "default": "Borsa fantastica, la uso ogni giorno!" }
      ]
    }
  ],
  "presets": [{ "name": "Recensioni Video" }]
}
{% endschema %}
