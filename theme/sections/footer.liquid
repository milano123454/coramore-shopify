<footer class="site-footer section" data-section-id="{{ section.id }}" data-testid="site-footer">
  <div class="page-width">
    <div class="footer__grid">
      <!-- Brand Column -->
      <div class="footer__col footer__col--brand">
        {%- if section.settings.logo -%}
          <img src="{{ section.settings.logo | image_url: width: 150 }}" alt="{{ shop.name }}" width="150" loading="lazy">
        {%- else -%}
          <span class="footer__logo-text">{{ shop.name }}</span>
        {%- endif -%}
        <p class="footer__slogan">{{ section.settings.slogan }}</p>
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" class="footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" class="footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" class="footer__social-link" aria-label="TikTok" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1 0-5.78 2.92 2.92 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.57 6.33 6.33 0 0 0 9.37 22a6.33 6.33 0 0 0 6.38-6.22V9.4a8.16 8.16 0 0 0 4.84 1.58v-3.4a4.85 4.85 0 0 1-1-.89z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Links Column -->
      <div class="footer__col">
        <h4 class="footer__heading">{{ section.settings.col2_title }}</h4>
        <nav class="footer__nav">
          {%- for block in section.blocks -%}
            {%- if block.type == 'link' -%}
              <a href="{{ block.settings.url }}" class="footer__link" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {%- endif -%}
          {%- endfor -%}
          {%- if section.blocks.size == 0 -%}
            <a href="/pages/spedizione" class="footer__link">Spedizione</a>
            <a href="/pages/resi" class="footer__link">Resi</a>
            <a href="/policies/privacy-policy" class="footer__link">Privacy</a>
            <a href="/pages/contatti" class="footer__link">Contatti</a>
            <a href="/#faq" class="footer__link">FAQ</a>
          {%- endif -%}
        </nav>
      </div>

      <!-- Payment & Security Column -->
      <div class="footer__col footer__col--payments">
        <h4 class="footer__heading">Pagamenti sicuri</h4>
        <div class="footer__payment-icons">
          <span class="payment-icon" title="Visa">
            <svg width="38" height="24" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#1A1F71"/><text x="19" y="15" text-anchor="middle" fill="white" font-size="10" font-weight="bold" font-family="sans-serif">VISA</text></svg>
          </span>
          <span class="payment-icon" title="Mastercard">
            <svg width="38" height="24" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#252525"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/></svg>
          </span>
          <span class="payment-icon" title="PayPal">
            <svg width="38" height="24" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#003087"/><text x="19" y="15" text-anchor="middle" fill="white" font-size="8" font-weight="bold" font-family="sans-serif">PayPal</text></svg>
          </span>
          <span class="payment-icon" title="Apple Pay">
            <svg width="38" height="24" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#000"/><text x="19" y="15" text-anchor="middle" fill="white" font-size="8" font-weight="bold" font-family="sans-serif">Pay</text></svg>
          </span>
          <span class="payment-icon" title="Google Pay">
            <svg width="38" height="24" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#fff" stroke="#ddd"/><text x="19" y="15" text-anchor="middle" fill="#5F6368" font-size="8" font-weight="bold" font-family="sans-serif">GPay</text></svg>
          </span>
        </div>
        <div class="footer__security">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>{{ 'footer.secure_checkout' | t }}</span>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. {{ 'footer.copyright' | t }}.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo footer"
    },
    {
      "type": "text",
      "id": "slogan",
      "label": "Slogan",
      "default": "Eleganza e praticita in una borsa."
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Titolo colonna link",
      "default": "Informazioni"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Testo link",
          "default": "Spedizione"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL",
          "default": "/pages/spedizione"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link", "settings": { "label": "Spedizione", "url": "/pages/spedizione" } },
        { "type": "link", "settings": { "label": "Resi", "url": "/pages/resi" } },
        { "type": "link", "settings": { "label": "Privacy", "url": "/policies/privacy-policy" } },
        { "type": "link", "settings": { "label": "Contatti", "url": "/pages/contatti" } },
        { "type": "link", "settings": { "label": "FAQ", "url": "/#faq" } }
      ]
    }
  ]
}
{% endschema %}
