<section class="cart-page">
  <div class="container">
    <h1 class="section-head__title text-center" style="margin-bottom:32px;">Il Tuo Carrello</h1>

    {%- if cart.item_count == 0 -%}
      <div class="text-center" style="padding:60px 0;">
        <p style="margin-bottom:24px; color:var(--color-secondary);">Il carrello è vuoto.</p>
        <a class="btn btn--primary btn--lg" href="{{ routes.all_products_collection_url }}">Continua lo shopping</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-page__layout">
          <div class="cart-page__items">
            {%- for item in cart.items -%}
              <div class="cart-line" data-line-key="{{ item.key }}" style="grid-template-columns:100px 1fr auto auto;">
                <div class="cart-line__media">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}">
                  {%- endif -%}
                </div>
                <div>
                  <div class="cart-line__title">
                    <a href="{{ item.url }}">{{ item.product.title }}</a>
                  </div>
                  {%- unless item.variant.title contains 'Default' -%}
                    <div class="cart-line__variant">{{ item.variant.title }}</div>
                  {%- endunless -%}
                </div>
                <div>
                  <div class="qty-selector" style="height:40px;">
                    <button type="button" data-qty-down>−</button>
                    <input type="number" name="updates[{{ item.key }}]" min="0" value="{{ item.quantity }}" data-line-qty>
                    <button type="button" data-qty-up>+</button>
                  </div>
                </div>
                <div style="text-align:right;">
                  <div class="cart-line__price">{{ item.final_line_price | money }}</div>
                  <a href="{{ item.url_to_remove }}" class="cart-line__remove">Rimuovi</a>
                </div>
              </div>
            {%- endfor -%}
          </div>

          <aside class="cart-page__summary">
            <h3>Riepilogo Ordine</h3>
            <div class="cart-page__summary-row">
              <span>Subtotale</span>
              <span>{{ cart.items_subtotal_price | money }}</span>
            </div>
            <div class="cart-page__summary-row">
              <span>Spedizione</span>
              <span style="color: var(--color-primary); font-weight:600;">GRATUITA</span>
            </div>
            <div class="cart-page__summary-row total">
              <span>Totale</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            <textarea name="note" placeholder="Note per l'ordine..." style="width:100%; min-height:80px; padding:12px; border:1px solid var(--color-border); border-radius:var(--radius); font:inherit; margin-top:12px;">{{ cart.note }}</textarea>

            <button type="submit" name="checkout" class="btn btn--primary btn--full btn--lg" style="margin-top:16px;">Procedi al Checkout</button>
            <button type="submit" name="update" class="btn btn--outline btn--full" style="margin-top:8px;">Aggiorna Carrello</button>

            <p style="font-size:12px; color:var(--color-muted); text-align:center; margin-top:14px;">
              Spese di spedizione e tasse calcolate al checkout. Pagamento sicuro SSL 256-bit.
            </p>
          </aside>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pagina carrello",
  "tag": "section",
  "class": "shopify-section-cart",
  "settings": []
}
{% endschema %}
