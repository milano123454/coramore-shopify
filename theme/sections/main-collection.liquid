<section class="collection-page">
  <div class="container">
    {%- if collection == blank -%}
      <div style="padding:80px 20px; text-align:center;">
        <h1 class="section-head__title">Anteprima Pagina Collezione</h1>
        <p class="section-head__lede" style="margin-top:16px; max-width:560px; margin-left:auto; margin-right:auto;">
          Crea una collezione in <strong>Shopify Admin → Collezioni</strong> per vederla qui.
        </p>
        <a class="btn btn--primary btn--lg" style="margin-top:24px;" href="{{ routes.root_url }}">Torna alla Home</a>
      </div>
    {%- else -%}
      <div class="collection-page__header">
        <h1 class="section-head__title">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <p class="section-head__lede">{{ collection.description | strip_html | truncatewords: 30 }}</p>
        {%- endif -%}
      </div>

      {%- paginate collection.products by 24 -%}
        {%- if collection.products.size > 0 -%}
          <div class="showcase-grid">
            {%- for product in collection.products -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="text-center" style="margin-top:48px; display:flex; gap:8px; justify-content:center;">
              {%- if paginate.previous -%}
                <a class="btn btn--outline" href="{{ paginate.previous.url }}">← Precedente</a>
              {%- endif -%}
              {%- if paginate.next -%}
                <a class="btn btn--outline" href="{{ paginate.next.url }}">Successiva →</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <p class="text-center" style="padding:60px 20px; color:var(--color-secondary);">Nessun prodotto in questa collezione.</p>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pagina collezione",
  "tag": "section",
  "class": "shopify-section--main-collection",
  "settings": []
}
{% endschema %}
