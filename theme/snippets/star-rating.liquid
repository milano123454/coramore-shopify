{%- comment -%}
  Render a 5-star rating.
  Usage: {% render 'star-rating', rating: 5 %}
{%- endcomment -%}
{%- assign r = rating | default: 5 | plus: 0 -%}
<span class="stars" aria-label="{{ r }} su 5 stelle">
  {%- for i in (1..5) -%}{%- if i <= r -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}
</span>
