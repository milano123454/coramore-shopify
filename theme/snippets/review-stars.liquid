{%- comment -%} Star rating snippet. Usage: {% render 'review-stars', rating: 4.9, color: '#00B67A' %} {%- endcomment -%}
{%- assign star_rating = rating | default: 5 -%}
{%- assign star_color = color | default: '#00B67A' -%}
<div class="review-stars" aria-label="{{ star_rating }} su 5 stelle">
  {%- for i in (1..5) -%}
    {%- if star_rating >= i -%}
      <svg class="star-icon star-full" width="20" height="20" viewBox="0 0 20 20" fill="{{ star_color }}" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 1.25l2.47 5.01 5.53.8-4 3.9.94 5.49L10 13.77l-4.94 2.68.94-5.49-4-3.9 5.53-.8L10 1.25z"/>
      </svg>
    {%- elsif star_rating >= i | minus: 0.5 -%}
      <svg class="star-icon star-half" width="20" height="20" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="half-{{ i }}">
            <stop offset="50%" stop-color="{{ star_color }}"/>
            <stop offset="50%" stop-color="#E0E0E0"/>
          </linearGradient>
        </defs>
        <path d="M10 1.25l2.47 5.01 5.53.8-4 3.9.94 5.49L10 13.77l-4.94 2.68.94-5.49-4-3.9 5.53-.8L10 1.25z" fill="url(#half-{{ i }})"/>
      </svg>
    {%- else -%}
      <svg class="star-icon star-empty" width="20" height="20" viewBox="0 0 20 20" fill="#E0E0E0" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 1.25l2.47 5.01 5.53.8-4 3.9.94 5.49L10 13.77l-4.94 2.68.94-5.49-4-3.9 5.53-.8L10 1.25z"/>
      </svg>
    {%- endif -%}
  {%- endfor -%}
</div>
