<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }} — {{ 'general.password_page.title' | t | default: 'Coming Soon' }}</title>
    {{ content_for_header }}
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&display=swap">
    <style>
      .password-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 40px 20px; background: var(--color-bg); }
      .password-page__inner { max-width: 520px; text-align: center; }
      .password-page__brand { font-family: var(--font-heading); font-size: 32px; letter-spacing: 0.18em; color: var(--color-primary); margin-bottom: 8px; }
      .password-page h1 { font-family: var(--font-heading); font-size: clamp(2rem, 5vw, 3rem); font-weight: 300; margin-bottom: 16px; }
      .password-page p { color: var(--color-secondary); margin-bottom: 24px; }
      .password-page form { display: flex; gap: 8px; justify-content: center; max-width: 380px; margin: 0 auto; }
      .password-page input { flex:1; padding: 14px; border: 1px solid var(--color-border); border-radius: var(--radius); font: inherit; }
    </style>
  </head>
  <body>
    <div class="password-page">
      <div class="password-page__inner">
        <div class="password-page__brand">{{ shop.name | upcase }}</div>
        <h1>{{ 'general.password_page.opening_soon' | t | default: 'Apriamo presto' }}</h1>
        <p>{{ shop.password_message }}</p>
        {% form 'storefront_password' %}
          <input type="password" name="password" placeholder="Password" required>
          <button type="submit" class="btn btn--primary">Entra</button>
        {% endform %}
        {{ content_for_layout }}
      </div>
    </div>
  </body>
</html>
