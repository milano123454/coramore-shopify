<section class="reviews">
  <div class="container">
    <div class="reviews__header">
      <h2 class="section-title">{{ section.settings.title }}</h2>
      <div class="reviews__rating-summary">
        <span class="reviews__stars">★★★★★</span>
        <span class="reviews__avg">{{ settings.trust_rating }}/5</span>
        <span class="reviews__count">basato su {{ settings.trust_reviews_count }} recensioni</span>
      </div>
    </div>


    <div class="reviews__grid">
      {%- for block in section.blocks -%}
        <div class="reviews__card" {{ block.shopify_attributes }}>
          <div class="reviews__card-stars">★★★★★</div>
          <p class="reviews__card-text">"{{ block.settings.text }}"</p>
          <div class="reviews__card-author">
            <span class="reviews__card-name">{{ block.settings.author }}</span>
            {%- if block.settings.verified -%}
              <span class="reviews__card-verified">✓ Acquisto verificato</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Recensioni",
  "class": "reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titolo",
      "default": "Cosa dicono i nostri clienti"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Recensione",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Testo recensione",
          "default": "Borsa bellissima, qualità incredibile. Il portafoglio in regalo è un tocco di classe!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Autore",
          "default": "Maria R."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Acquisto verificato",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recensioni",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "text": "Borsa bellissima, qualità incredibile. Il portafoglio in regalo è un tocco di classe!",
            "author": "Maria R.",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "Spedizione velocissima e prodotto conforme alle foto. Consigliatissimo!",
            "author": "Giulia T.",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "Elegante e pratica. La uso tutti i giorni e ricevo sempre complimenti.",
            "author": "Francesca M.",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "Ho regalato questa borsa a mia moglie, è rimasta entusiasta. Qualità top.",
            "author": "Marco L.",
            "verified": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
